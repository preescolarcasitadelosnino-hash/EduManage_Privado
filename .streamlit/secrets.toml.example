# Copia este archivo como secrets.toml solamente en el entorno local o cloud.
# No coloques credenciales reales en Git.

DB_HOST = "tu-host-de-supabase"
DB_NAME = "postgres"
DB_USER = "tu-usuario-de-supabase"
DB_PASSWORD = "tu-contrasena-de-supabase"
DB_PORT = "5432"
DB_SSLMODE = "require"

# Opcionales; los valores predeterminados de la aplicación son 1 y 5.
DB_POOL_MINCONN = 1
DB_POOL_MAXCONN = 5

# Opcional: token OAuth de Google Drive serializado como JSON en una sola
# cadena. No pegues aquí el token real en un archivo que vaya a Git.
GOOGLE_TOKEN_JSON = ""
GOOGLE_ALLOW_LOCAL_OAUTH = true

# ID de la carpeta raíz exclusiva de Google Drive para este despliegue.
GOOGLE_DRIVE_ROOT = "id-de-la-carpeta-raiz-privada"

# JSON de la cuenta de servicio privada, serializado en una sola cadena.
GOOGLE_SERVICE_ACCOUNT_JSON = ""

# Alternativa recomendada para Streamlit: JSON codificado en Base64 en una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON_B64 = ""
